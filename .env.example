VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Optionnel : pour exécuter le schéma SQL (Project Settings → Database → URI)
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@db.VOTRE_PROJET.supabase.co:5432/postgres

# Génération de programmes et analyse des repas (fonctions serverless).
# Clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=votre_cle_groq
# Optionnel — défauts adaptés au tier gratuit :
# - programme : llama-3.3-70b-versatile (~1 000 req/jour)
# - repas : llama-3.1-8b-instant (~14 400 req/jour)
# GROQ_MODEL_PROGRAM=llama-3.3-70b-versatile
# GROQ_MODEL_MEAL=llama-3.1-8b-instant
